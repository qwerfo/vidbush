# Vidbush environment. Copy to .env and fill what you have.
# Any role left empty runs in mock mode, so the pipeline always completes.
# A role you did configure never silently uses mock: if all its providers fail,
# the stage fails and `python -m vidbush resume <id>` retries it later.
# Check keys and model names with: python -m vidbush doctor --probe
# Text and vision providers are OpenAI-compatible relays (any base URL) or the native Anthropic
# Messages API (provider type anthropic). Provider types are set in config/seats.yaml.

# ---------------------------------------------------------------- text and vision seats
# Seat policy (Adam, 2026-11-11), wired in config/seats.yaml (exact order per role):
# - writer, Opus 5.5: wellflow_cheap (WELLFLOW_CHEAP, the Wellflow key that serves Anthropic models only),
#   then CloseRouter, then anthropic_direct (ANTHROPIC_KEY, native Messages API).
# - director and researcher, Sonnet 5.5: CloseRouter, then openlux, then anthropic_direct.
# - editor, Grok 4.7: CloseRouter, then openlux, then Wellflow (normal key).
# - judge, vision, cheap_classifier, Gemini 3.8 Flash: CloseRouter, then openlux, then Wellflow.
# Ids a relay has not been seen to list are read from its GET /models at startup (model_match) and logged
# once. Every text provider streams. Keys may live in .env or .env.local (.env.local wins; the process
# environment wins over both).
WELLFLOW_BASE_URL=https://api.wellflow.dev/v1
WELLFLOW_CHEAP=
WELLFLOW_API_KEY=
CLOSEROUTER_BASE_URL=https://api.closerouter.dev/v1
CLOSEROUTER_API_KEY=
OPENLUX_BASE_URL=https://api.openlux.ai/v1
OPENLUX_API_KEY=
ANTHROPIC_DIRECT_BASE_URL=https://api.anthropic.com
ANTHROPIC_KEY=

# Which provider is primary for a while is a switch here, not a config edit: providers named in
# VIDBUSH_PREFER_PROVIDER (comma list) move to the front of every role they serve (tts and image included),
# until VIDBUSH_PREFER_UNTIL (ISO date and time, UTC) passes; then the seats.yaml order applies again.
# Empty: the seats.yaml order.
VIDBUSH_PREFER_PROVIDER=
VIDBUSH_PREFER_UNTIL=

# Optional exact pins for CloseRouter's Sonnet 5.5 (empty: resolved from its GET /models). A pin that names
# another model than Sonnet 5.5 is a stale leftover and is ignored with one warning. The old
# LLM_WRITER_MODEL, LLM_CHEAP_MODEL, LLM_FALLBACK_CHEAP_MODEL and VISION_* model variables are no longer
# read: those seats carry exact ids in config/seats.yaml.
LLM_RESEARCHER_MODEL=
LLM_DIRECTOR_MODEL=

# Image generation. The fallback serves only a request the primary failed. Provider type is set in
# config/seats.yaml: openai_compat (/images/generations; options.mode: chat for OpenRouter image
# models), elevate (https://public-api.elevate.uno), algrow (https://api.algrow.online), fal, runware.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_FALLBACK_BASE_URL=
IMAGE_FALLBACK_API_KEY=
IMAGE_FALLBACK_MODEL=

# Optional image-to-video seat (fal.ai style). Off unless set and the profile opts in.
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=

# ---------------------------------------------------------------- narration
# TTS order (Adam, 2026-11-11): ElevenLabs direct (its key has credits), then Elevate, then Algrow. Algrow
# and Elevate return no word timings: Vidbush aligns their audio against the script with faster-whisper (install the whisper extra).
# Voice ids differ by provider: set them per provider in the brand yaml (voice.voice_ids); voice.voice_id
# is the default for any provider without its own entry.
ELEVATE_BASE_URL=https://public-api.elevate.uno
ELEVATE_API_KEY=
ALGROW_BASE_URL=https://api.algrow.online
ALGROW_API_KEY=
# ElevenLabs direct. The default brand uses the premade voice "Brian" (nPczCjzI2devNBz1zQrb), which
# exists on every account. ELEVENLABS_VOICE_ID is used for brands whose voice_id is empty (then Brian).
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=

# Web search for research: tavily, serper or brave (set the type in config/seats.yaml too).
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Stock footage and images (free keys).
PEXELS_API_KEY=
PIXABAY_API_KEY=

# true or false. YouTube sourcing through yt-dlp.
YOUTUBE_ENABLED=true
# YouTube often asks servers and VPS IPs to "sign in to confirm you are not a bot".
# Fix: export cookies from a browser logged in to a throwaway Google account
# (extension "Get cookies.txt LOCALLY") and set the file path here,
YOUTUBE_COOKIES=
# or name a browser on this machine that is logged in: chrome, firefox, edge, brave.
YOUTUBE_COOKIES_FROM_BROWSER=
# Contact put in the User-Agent sent to Wikimedia hosts only (their policy asks for one), e.g. an email.
VIDBUSH_CONTACT=

# Folders. Relative paths are relative to the repo root.
MUSIC_FOLDER=fixtures/music
OUTPUT_FOLDER=output
SOURCE_CACHE_FOLDER=data/source_cache

# Set to 1 to force mock mode for every seat and skip all network calls.
VIDBUSH_OFFLINE=0
# Set to 1 to let a configured role fall back to mock output when all its providers
# fail a request (the project then ends as needs_review). Default 0: the stage fails.
VIDBUSH_ALLOW_MOCK_FALLBACK=0
# Test hook: name a stage to raise an error when it starts (used by the resume test).
VIDBUSH_FAIL_AT=
