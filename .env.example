# Vidbush environment. Copy to .env and fill what you have.
# Any role left empty runs in mock mode, so the pipeline always completes.
# A role you did configure never silently uses mock: if all its providers fail,
# the stage fails and `python -m vidbush resume <id>` retries it later.
# Check keys and model names with: python -m vidbush doctor --probe
# Every LLM, vision and image provider uses the OpenAI-compatible HTTP format,
# so OpenRouter or any relay works by setting its base URL and key.

# Main text model (researcher, director). Example base URL: https://openrouter.ai/api/v1
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
# Model for the writer seat (scripts). Leave empty to use the value in seats.yaml.
LLM_WRITER_MODEL=
# Cheap fast model for the chat editor seat.
LLM_CHEAP_MODEL=

# Fallback text provider, used only for a request the primary failed.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Vision model for the judge, QA pass, and style learner.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
# Cheaper vision model for shot classification in learn-style.
VISION_CHEAP_MODEL=

# Image generation (OpenAI-compatible /images/generations). The fallback serves only a request
# the primary failed. For OpenRouter image models set options.mode: chat in config/seats.yaml.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_FALLBACK_BASE_URL=
IMAGE_FALLBACK_API_KEY=
IMAGE_FALLBACK_MODEL=

# Optional image-to-video seat (fal.ai style). Off unless set and the profile opts in.
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=

# ElevenLabs narration. Base URL can point at a relay. The voice id goes in the brand yaml
# (config/brands/<id>.yaml voice.voice_id). The default brand uses the premade voice "Brian"
# (nPczCjzI2devNBz1zQrb), which exists on every account, so a key alone gives real narration.
# ELEVENLABS_VOICE_ID is used for brands whose voice_id is empty (then Brian).
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=

# Web search for research: tavily, serper or brave (set the type in config/seats.yaml too).
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Stock footage and images (free keys).
PEXELS_API_KEY=
PIXABAY_API_KEY=

# true or false. YouTube sourcing through yt-dlp.
YOUTUBE_ENABLED=true
# YouTube often asks servers and VPS IPs to "sign in to confirm you are not a bot".
# Fix: export cookies from a browser logged in to a throwaway Google account
# (extension "Get cookies.txt LOCALLY") and set the file path here,
YOUTUBE_COOKIES=
# or name a browser on this machine that is logged in: chrome, firefox, edge, brave.
YOUTUBE_COOKIES_FROM_BROWSER=
# Contact put in the User-Agent for Wikimedia and loc.gov (they ask for one), e.g. an email.
VIDBUSH_CONTACT=

# Folders. Relative paths are relative to the repo root.
MUSIC_FOLDER=fixtures/music
OUTPUT_FOLDER=output
SOURCE_CACHE_FOLDER=data/source_cache

# Set to 1 to force mock mode for every seat and skip all network calls.
VIDBUSH_OFFLINE=0
# Set to 1 to let a configured role fall back to mock output when all its providers
# fail a request (the project then ends as needs_review). Default 0: the stage fails.
VIDBUSH_ALLOW_MOCK_FALLBACK=0
# Test hook: name a stage to raise an error when it starts (used by the resume test).
VIDBUSH_FAIL_AT=
