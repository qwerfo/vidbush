        "duration": {
          "title": "Duration",
          "type": "number"
        },
        "width": {
          "default": 1920,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 30,
          "title": "Fps",
          "type": "integer"
