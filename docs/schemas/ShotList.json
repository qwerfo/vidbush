    "SourceKind": {
      "enum": [
        "youtube",
        "wikimedia",
        "archive",
        "loc",
        "nasa",
        "pexels",
        "pixabay",
        "local",
        "ai_image",
        "ai_video",
        "upload",
        "motion"
