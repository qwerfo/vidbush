          "title": "Media",
          "type": "string"
        },
        "in_point": {
          "default": 0.0,
          "title": "In Point",
          "type": "number"
        },
        "out_point": {
          "default": 0.0,
          "title": "Out Point",
          "type": "number"
        },
        "width": {
          "default": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 0,
          "title": "Height",
          "type": "integer"
        },
        "licence": {
          "default": "unknown",
          "title": "Licence",
          "type": "string"
        },
        "author": {
          "default": "",
          "title": "Author",
          "type": "string"
        },
        "attribution": {
          "default": "",
          "title": "Attribution",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "keyframes": {
          "items": {
            "type": "string"
          },
          "title": "Keyframes",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "judge_reason": {
          "default": "",
          "title": "Judge Reason",
          "type": "string"
        },
        "reject_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
