        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "selected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected"
        },
        "judge_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Score"
        },
        "judge_notes": {
          "default": "",
          "title": "Judge Notes",
          "type": "string"
        },
        "attempts": {
          "default": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "framing": {
          "default": "full",
          "enum": [
            "full",
            "tight",
            "detail"
          ],
          "title": "Framing",
          "type": "string"
        },
        "transition_in": {
          "default": "cut",
          "enum": [
            "cut",
            "fade"
          ],
          "title": "Transition In",
          "type": "string"
        },
        "overlay_path": {
          "default": "",
          "title": "Overlay Path",
          "type": "string"
        },
        "kenburns": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kenburns"
        },
        "render_segment_path": {
          "default": "",
          "title": "Render Segment Path",
          "type": "string"
        },
        "render_hash": {
          "default": "",
          "title": "Render Hash",
          "type": "string"
        }
