  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "fps": {
      "default": 30,
      "title": "Fps",
      "type": "integer"
    },
    "width": {
      "default": 1920,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "default": 1080,
      "title": "Height",
      "type": "integer"
    },
    "duration": {
      "title": "Duration",
      "type": "number"
    },
