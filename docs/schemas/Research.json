{
  "$defs": {
    "FactCard": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "title": "Source Url",
          "type": "string"
        },
        "source_title": {
          "default": "",
          "title": "Source Title",
          "type": "string"
        },
        "confidence": {
          "default": 0.7,
          "title": "Confidence",
          "type": "number"
        },
        "date": {
          "default": "",
          "title": "Date",
          "type": "string"
        },
        "status": {
          "default": "unverified",
