            "verified",
            "unverified",
            "contradicted"
          ],
          "title": "Status",
          "type": "string"
        },
        "numbers": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Numbers",
          "type": "array"
        }
      },
      "required": [
        "id",
        "claim"
      ],
      "title": "FactCard",
      "type": "object"
    },
    "VisualAnchor": {
      "properties": {
        "kind": {
          "enum": [
            "place",
            "date",
            "object",
            "person",
            "event",
            "number"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "VisualAnchor",
      "type": "object"
    }
  },
  "properties": {
    "topic": {
      "title": "Topic",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/FactCard"
      },
      "title": "Facts",
      "type": "array"
    },
    "anchors": {
      "items": {
        "$ref": "#/$defs/VisualAnchor"
      },
      "title": "Anchors",
      "type": "array"
    },
    "sources": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "topic"
  ],
  "title": "Research",
  "type": "object"
}